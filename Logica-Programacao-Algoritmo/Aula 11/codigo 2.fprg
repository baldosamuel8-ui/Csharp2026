<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="codigo 2"/>
        <attribute name="authors" value="FIC"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-09 07:30:58 "/>
        <attribute name="created" value="RklDO0VDRlA1MDdEMTMxOTM3OTsyMDI2LTAzLTA5OyIwNzoyMTowMyAiOzIyNzk="/>
        <attribute name="edited" value="RklDO0VDRlA1MDdEMTMxOTM3OTsyMDI2LTAzLTA5OyIwNzozMDo1OCAiOzE7MjM5Nw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="nota1, nota2, notafinal" type="Real" array="False" size=""/>
            <output expression="&quot;Digite a primeira Nota:&quot;" newline="True"/>
            <input variable="nota1"/>
            <output expression="&quot;Digite a segunda Nota:&quot;" newline="True"/>
            <input variable="nota2"/>
            <assign variable="notafinal" expression="nota1 + nota2"/>
            <if expression="notafinal &gt; 60">
                <then>
                    <output expression="&quot;Aprovado, Nota final: &quot; &amp; notafinal" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Reprovado, Nota final: &quot; &amp; notafinal" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
