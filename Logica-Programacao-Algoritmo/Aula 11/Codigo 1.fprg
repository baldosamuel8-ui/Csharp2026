<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Codigo 1"/>
        <attribute name="authors" value="FIC"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-03-09 07:18:02 "/>
        <attribute name="created" value="RklDO0VDRlA1MDdEMTMxOTM3OTsyMDI2LTAzLTA5OyIwNzowMDoxOSAiOzIyODM="/>
        <attribute name="edited" value="RklDO0VDRlA1MDdEMTMxOTM3OTsyMDI2LTAzLTA5OyIwNzoxODowMiAiOzE7MjM5Mg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="largura, altura, valor, area, preco" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o valor da largura:&quot;" newline="True"/>
            <input variable="largura"/>
            <output expression="&quot;Digite o valor da altura:&quot;" newline="True"/>
            <input variable="altura"/>
            <output expression="&quot;Digite o valor do metro quadrado:&quot;" newline="True"/>
            <input variable="valor"/>
            <assign variable="area" expression="largura * altura"/>
            <assign variable="preco" expression="area * valor"/>
            <output expression="&quot;O valor da area &#233; de : &quot; &amp; area &amp; &quot; e o valor do terreno &#233; de R$ &quot; &amp; preco" newline="True"/>
        </body>
    </function>
</flowgorithm>
